{# OpenShift Virtualization's operator. Rendered so the catalog follows
   acm_catalog_source on a disconnected hub, the same way roles/setup-hub-acm
   renders its subscriptions. #}
apiVersion: v1
kind: Namespace
metadata:
  name: openshift-cnv
---
apiVersion: operators.coreos.com/v1
kind: OperatorGroup
metadata:
  name: kubevirt-hyperconverged-group
  namespace: openshift-cnv
spec:
  targetNamespaces:
    - openshift-cnv
---
apiVersion: operators.coreos.com/v1alpha1
kind: Subscription
metadata:
  name: hco-operatorhub
  namespace: openshift-cnv
spec:
  channel: {{ kubevirt_cnv_channel }}
  name: kubevirt-hyperconverged
  installPlanApproval: Automatic
  source: {{ kubevirt_catalog_source }}
  sourceNamespace: {{ kubevirt_catalog_source_namespace }}
