{# Import into ACM - only with kubevirt_acm_import, as MCE's hypershift
   add-on otherwise creates these itself. The same objects it creates:
   hosted on local-cluster, klusterlet in Hosted mode, labels left to ACM's
   auto-detect. Rendered only for the kinds the management cluster actually
   has: MCE alone has ManagedCluster but no KlusterletAddonConfig. #}
{% if kubevirt_has_managedcluster | bool %}
---
apiVersion: cluster.open-cluster-management.io/v1
kind: ManagedCluster
metadata:
  annotations:
    import.open-cluster-management.io/hosting-cluster-name: local-cluster
    import.open-cluster-management.io/klusterlet-deploy-mode: Hosted
    open-cluster-management/created-via: hypershift
  labels:
    cloud: auto-detect
    vendor: auto-detect
    name: {{ kv.name }}
    cluster.open-cluster-management.io/clusterset: {{ hosted_cluster_clusterset | default('default') }}
  name: {{ kv.name }}
spec:
  hubAcceptsClient: true
{% endif %}
{% if kubevirt_has_klusterletaddonconfig | bool %}
---
apiVersion: agent.open-cluster-management.io/v1
kind: KlusterletAddonConfig
metadata:
  name: {{ kv.name }}
  namespace: {{ kv.name }}
spec:
  clusterName: {{ kv.name }}
  clusterNamespace: {{ kv.name }}
  clusterLabels:
    cloud: auto-detect
    vendor: auto-detect
  applicationManager:
    enabled: {{ hosted_cluster_addon_application_manager | default(true) | lower }}
  policyController:
    enabled: {{ hosted_cluster_addon_policy_controller | default(true) | lower }}
  searchCollector:
    enabled: {{ hosted_cluster_addon_search_collector | default(true) | lower }}
  certPolicyController:
    enabled: {{ hosted_cluster_addon_cert_policy_controller | default(true) | lower }}
{% endif %}
