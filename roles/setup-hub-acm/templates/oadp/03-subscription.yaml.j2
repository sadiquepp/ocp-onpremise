# Rendered per-run so the catalog the operator resolves against can differ
# between a connected and a disconnected hub - see acm_catalog_source in
# roles/setup-hub-acm/defaults/main.yml. Everything else about this
# Subscription is the same either way, so this is one template rather than a
# connected and a disconnected copy.
apiVersion: operators.coreos.com/v1alpha1
kind: Subscription
metadata:
  name: redhat-oadp-operator
  namespace: openshift-adp
spec:
  channel: "{{ oadp_operator_channel }}"
{% if oadp_operator_starting_csv | default('') | length > 0 %}
  # Pinned (oadp_operator_starting_csv): only this CSV's InstallPlan is
  # approved, by roles/setup-hub-acm, so OLM never upgrades past it.
  startingCSV: "{{ oadp_operator_starting_csv }}"
  installPlanApproval: Manual
{% else %}
  installPlanApproval: Automatic
{% endif %}
  name: redhat-oadp-operator
  source: "{{ acm_catalog_source }}"
  sourceNamespace: "{{ acm_catalog_source_namespace }}"
