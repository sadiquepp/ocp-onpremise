apiVersion: velero.io/v1
kind: Restore
metadata:
  name: "{{ hcp_cluster_name }}-restore"
  namespace: openshift-adp
spec:
  backupName: "{{ hcp_cluster_name }}-backup"
  restorePVs: true
  existingResourcePolicy: update
  excludedResources:
    - nodes
    - events
    - events.events.k8s.io
    - backups.velero.io
    - restores.velero.io
    - resticrepositories.velero.io
{% if oadp_restore_detach_bmh | default(false) | bool %}
  # oadp_restore_detach_bmh: restore every BareMetalHost with the
  # baremetalhost.metal3.io/detached annotation, so this hub's Bare Metal
  # Operator leaves the hosts alone until you remove it. The ConfigMap is
  # applied by restore_hosted_cluster.yaml from
  # restore-bmh-detached-modifier.yaml.j2.
  resourceModifier:
    kind: ConfigMap
    name: {{ oadp_restore_bmh_modifier_name }}
{% endif %}
